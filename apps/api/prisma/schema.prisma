// Prisma schema for SDG Impact Cloud
// See docs/13-data-model.md for design rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Identity & Tenancy (RLS-protected)
// ============================================================

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  region    String   @default("kr")
  plan      String   @default("starter") // starter | growth | enterprise
  status    String   @default("active") // active | suspended | deleted
  createdAt DateTime @default(now()) @map("created_at")

  users        User[]
  memberships  Membership[]
  auditEvents  AuditEvent[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String
  displayName  String?  @map("display_name")
  passwordHash String?  @map("password_hash")
  authProvider String   @default("local") @map("auth_provider")
  mfaEnabled   Boolean  @default(false) @map("mfa_enabled")
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  memberships Membership[]
  auditEvents AuditEvent[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@map("users")
}

model Role {
  id          String       @id @default(uuid()) @db.Uuid
  key         String       @unique // admin | reviewer | contributor | viewer | auditor
  name        String
  memberships Membership[]

  @@map("roles")
}

model Membership {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  roleId   String @map("role_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([tenantId, userId, roleId])
  @@map("memberships")
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  before       Json?
  after        Json?
  occurredAt   DateTime @default(now()) @map("occurred_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  actor  User?   @relation(fields: [actorId], references: [id])

  @@index([tenantId, occurredAt])
  @@index([resourceType, resourceId])
  @@map("audit_events")
}

// ============================================================
// SDG Catalog (global, read-only — not RLS-bound)
// ============================================================

model SdgGoal {
  id          String       @id // SDG-1..SDG-17
  number      Int          @unique
  nameI18n    Json         @map("name_i18n")
  color       String
  icon        String?
  targets     SdgTarget[]

  @@map("sdg_goals")
}

model SdgTarget {
  id       String           @id // SDG-13.2 etc
  goalId   String           @map("goal_id")
  textI18n Json             @map("text_i18n")
  type     String           @default("outcome") // outcome | means

  goal       SdgGoal        @relation(fields: [goalId], references: [id])
  indicators SdgIndicator[]

  @@index([goalId])
  @@map("sdg_targets")
}

model SdgIndicator {
  id          String  @id // SDG-13.2.1 etc
  targetId    String  @map("target_id")
  unit        String
  methodology String?
  tier        Int

  target SdgTarget @relation(fields: [targetId], references: [id])

  @@index([targetId])
  @@map("sdg_indicators")
}

// ============================================================
// Weekly Global SDG Watch (ADR-0012, public + RLS-aware)
// ============================================================

// A place worth checking each week (UN agency, donor, journal, NGO, repo).
// Sources are global/shared (not RLS-bound) so every tenant benefits.
model WatchSource {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  url          String
  feedUrl      String?  @map("feed_url")
  kind         String   // 'rss' | 'atom' | 'html' | 'github' | 'api'
  category     String   // 'un' | 'donor' | 'academic' | 'ngo' | 'civic' | 'regional' | 'funding'
  language     String   @default("en")
  region       String?  // ISO-3166 alpha-2 or 'global'
  sdgFocus     String[] @default([]) @map("sdg_focus") // e.g. ['SDG-13','SDG-15']
  active       Boolean  @default(true)
  lastScannedAt DateTime? @map("last_scanned_at")
  failureCount Int      @default(0) @map("failure_count")
  createdAt    DateTime @default(now()) @map("created_at")

  items WatchItem[]

  @@unique([url])
  @@index([category, active])
  @@index([language])
  @@map("watch_sources")
}

// One discovered finding from a source.
// Items are global so feeds and search benefit every tenant; per-user
// state (saved, dismissed, interested) lives in WatchSubscription/Interest.
model WatchItem {
  id           String   @id @default(uuid()) @db.Uuid
  sourceId    String   @map("source_id") @db.Uuid
  url         String
  title       String
  summary     String?
  language    String   @default("en")
  publishedAt DateTime? @map("published_at")
  discoveredAt DateTime @default(now()) @map("discovered_at")
  sdgFocus    String[] @default([]) @map("sdg_focus")
  region      String?
  contentHash String   @map("content_hash") // sha256(url+normalized title)
  // AI-assisted multilingual summary: { en: { summary, confidence }, ko: ..., ... }
  // Per data-sovereignty principle, raw AI runs are stored only with provenance
  // and are user-overridable.
  i18nSummary Json?    @map("i18n_summary")

  source         WatchSource              @relation(fields: [sourceId], references: [id])
  collaborations CollaborationInterest[]

  @@unique([contentHash])
  @@index([sourceId, discoveredAt])
  @@index([sdgFocus], type: Gin)
  @@map("watch_items")
}

// A user's saved filter for what they want to hear about each week.
// RLS-bound; only the owner sees their own subscriptions.
model WatchSubscription {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  name         String   @default("My weekly watch")
  // Filter shape (kept as JSON for forward-compatibility):
  // { sdgFocus?: string[], categories?: string[], languages?: string[], regions?: string[] }
  filter       Json
  digestLanguage String @default("en") @map("digest_language")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId, userId, active])
  @@map("watch_subscriptions")
}

// Private record that a user is interested in collaborating around an item.
// NEVER auto-broadcast: see ADR-0012 §"Collaboration workflow".
// RLS-bound; only the owner sees their own interests.
model CollaborationInterest {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  note      String?
  intent    String   @default("learn") // 'learn' | 'partner' | 'fund' | 'volunteer'
  contactConsent Boolean @default(false) @map("contact_consent")
  createdAt DateTime @default(now()) @map("created_at")

  item WatchItem @relation(fields: [itemId], references: [id])

  @@unique([tenantId, userId, itemId])
  @@index([itemId])
  @@map("collaboration_interests")
}

// ============================================================
// Daily Columns + Multi-channel Approval + Partners (ADR-0013)
// ============================================================

// A curated daily column. Begins as 'draft', moves to 'pending' on submit,
// becomes 'published' once enough approvers have approved (n-of-m), or
// 'rejected' / 'revoked' under negative outcomes.
model Column {
  id              String   @id @default(uuid()) @db.Uuid
  // Tenant-scoped editorial process. RLS applies to drafts/pending/rejected.
  // Once 'published', columns are also exposed via the public feed.
  tenantId        String   @map("tenant_id") @db.Uuid
  authorId        String?  @map("author_id") @db.Uuid // who curated it
  state           String   @default("draft") // draft | pending | published | rejected | revoked
  // 'external' = curated from outside sources; 'internal' = our own publication.
  // Two-section UX (ADR-0014 §4): readers always see which section they are reading.
  origin          String   @default("external") // 'external' | 'internal'
  // Multilingual body: { en: { title, summary, excerpt, attribution }, ko: ..., ar: ... }
  bodyI18n        Json     @map("body_i18n")
  primaryLocale   String   @default("ko") @map("primary_locale")
  // 12-rule integrity verifier outcome (CONTENT_STANDARD §8 + ADR-0014 §5).
  // Stored so admins can audit *which* rules passed or failed at submit time.
  integrityReport Json?    @map("integrity_report")
  // Source attribution
  sourceUrl       String   @map("source_url")
  sourceTitle     String?  @map("source_title")
  sourceAuthors   String[] @default([]) @map("source_authors")
  sourcePublisher String?  @map("source_publisher")
  sourceLicense   String?  @map("source_license")
  sourcePublishedAt DateTime? @map("source_published_at")
  // SDG mapping with confidence and human/AI provenance
  sdgFocus        String[] @default([]) @map("sdg_focus")
  sdgConfidence   Float?   @map("sdg_confidence")
  sensitivity     String   @default("standard") // standard | sensitive (medical/legal/child/conflict)
  // Audit / content-standard provenance
  standardVersion String   @default("v0.1") @map("standard_version")
  aiProvenance    Json?    @map("ai_provenance") // { model, prompt_version, drafted_at }
  // Lifecycle timestamps
  submittedAt     DateTime? @map("submitted_at")
  publishedAt     DateTime? @map("published_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime @default(now()) @map("created_at")

  approvalRequests ApprovalRequest[]

  @@index([tenantId, state, createdAt])
  @@index([state, publishedAt])
  @@index([sdgFocus], type: Gin)
  @@map("columns")
}

// Who is allowed to approve columns (per tenant). Adding an approver itself
// is a sensitive action — see ADR-0013 §"Self-governance of approvers".
model ColumnApprover {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  // Channels this approver has consented to receive approval requests via:
  channels    String[] @default(["email", "inapp"]) // 'email' | 'sms' | 'inapp' | 'webhook'
  // For SMS channel — required only when 'sms' is in channels
  phoneE164   String?  @map("phone_e164")
  // True if this approver may approve sensitive columns (requires 2-of-m)
  sensitiveOk Boolean  @default(false) @map("sensitive_ok")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([tenantId, userId])
  @@index([tenantId, active])
  @@map("column_approvers")
}

// One approver × one column. Token-bearing.
// HMAC token format: see ADR-0013 §3.
model ApprovalRequest {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  columnId     String   @map("column_id") @db.Uuid
  approverId   String   @map("approver_id") @db.Uuid
  channel      String   // 'email' | 'sms' | 'inapp' | 'webhook'
  // Public-side token id; the actual HMAC token is computed at issue time
  // and not stored. We store only the request id and the decision metadata.
  expiresAt    DateTime @map("expires_at")
  decision     String?  // null | 'approve' | 'reject' | 'revise'
  decidedAt    DateTime? @map("decided_at")
  decidedVia   String?  @map("decided_via") // channel actually used
  reasonNote   String?  @map("reason_note")
  createdAt    DateTime @default(now()) @map("created_at")

  column Column @relation(fields: [columnId], references: [id])

  @@index([tenantId, columnId])
  @@index([approverId, decision])
  @@index([expiresAt])
  @@map("approval_requests")
}

// A registered partner organisation that may receive published columns
// or use our APIs. HMAC secret used to sign outbound webhooks. The secret
// is only ever returned to the partner once, on creation.
model PartnerOrganization {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  homepageUrl  String?  @map("homepage_url")
  contactEmail String   @map("contact_email")
  hmacSecret   String   @map("hmac_secret") // store only hashed; never log raw
  scopes       String[] @default([]) // 'column.published' | 'column.revoked' | 'feed.read'
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  webhooks PartnerWebhook[]

  @@map("partner_organizations")
}

// One outbound endpoint registered by a partner.
model PartnerWebhook {
  id              String   @id @default(uuid()) @db.Uuid
  partnerId       String   @map("partner_id") @db.Uuid
  url             String
  events          String[] @default(["column.published"])
  active          Boolean  @default(true)
  lastStatus      Int?     @map("last_status")
  lastDeliveredAt DateTime? @map("last_delivered_at")
  failureCount    Int      @default(0) @map("failure_count")
  createdAt       DateTime @default(now()) @map("created_at")

  partner PartnerOrganization @relation(fields: [partnerId], references: [id])

  @@index([partnerId, active])
  @@map("partner_webhooks")
}

// ============================================================
// Research proposals + expert outreach + chat (ADR-0014)
// ============================================================

// A research / project plan inspired by curated findings. Owned by an admin
// or accredited researcher inside a tenant. Sharing with collaborators is
// always opt-in via ExpertOutreach (never auto-broadcast — see ADR-0012).
model ResearchProposal {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  ownerId      String   @map("owner_id") @db.Uuid
  state        String   @default("draft") // draft | review | approved | retired
  // Multilingual content: { ko: { title, abstract, plan }, en: ..., ... }
  bodyI18n     Json     @map("body_i18n")
  primaryLocale String  @default("ko") @map("primary_locale")
  sdgFocus     String[] @default([]) @map("sdg_focus")
  inspiredByItemIds String[] @default([]) @map("inspired_by_item_ids") // WatchItem ids
  inspiredByColumnIds String[] @default([]) @map("inspired_by_column_ids") // Column ids
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  outreaches ExpertOutreach[]

  @@index([tenantId, state, createdAt])
  @@index([ownerId])
  @@map("research_proposals")
}

// A *draft* outreach to an external expert. Created and visible only to the
// proposal owner; sending requires an explicit human action that also
// records consent for any contact details used.
model ExpertOutreach {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  proposalId    String   @map("proposal_id") @db.Uuid
  expertName    String   @map("expert_name")
  expertOrg     String?  @map("expert_org")
  expertEmail   String?  @map("expert_email")
  draftMessage  String   @map("draft_message")
  draftLocale   String   @default("en") @map("draft_locale")
  state         String   @default("draft") // draft | sent | replied | declined | withdrawn
  sentAt        DateTime? @map("sent_at")
  consentRecord Json?    @map("consent_record") // when, how, by whom contact was consented
  createdAt     DateTime @default(now()) @map("created_at")

  proposal ResearchProposal @relation(fields: [proposalId], references: [id])

  @@index([tenantId, proposalId])
  @@index([state])
  @@map("expert_outreaches")
}

// A chat conversation. Members write in their own language; the platform
// translates for the others while preserving the original verbatim.
// Translation always tags model + confidence + timestamp (ADR-0014 §2).
model Conversation {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  topic       String?
  // Members and their preferred locales:
  //   { userId: { locale: 'ko' | 'en' | ... } }
  members     Json
  createdAt   DateTime @default(now()) @map("created_at")
  archivedAt  DateTime? @map("archived_at")

  messages Message[]

  @@index([tenantId, createdAt])
  @@map("conversations")
}

model Message {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  conversationId  String   @map("conversation_id") @db.Uuid
  authorId        String   @map("author_id") @db.Uuid
  originalText    String   @map("original_text")
  originalLocale  String   @map("original_locale")
  // Cached translations: { en: { text, model, confidence, translatedAt }, ... }
  // The original is NEVER overwritten by translations.
  translations    Json?
  createdAt       DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([tenantId, conversationId, createdAt])
  @@map("messages")
}

// ============================================================
// Short-form video stories (ADR-0015)
// ============================================================

// One story spawned from one published Column. Variants below are produced
// per locale × age tier. State applies to the story-as-a-whole; each variant
// has its own state so partial publication is supported.
model ShortStory {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  sourceColumnId String  @map("source_column_id") @db.Uuid
  state        String   @default("drafting") // drafting | ready | retired
  // SDG focus copied from the source for fast filtering.
  sdgFocus     String[] @default([]) @map("sdg_focus")
  // Region tag for equity-weight boost (LDC ISO codes -> +30% priority)
  region       String?
  createdAt    DateTime @default(now()) @map("created_at")

  variants StoryVariant[]

  @@index([tenantId, state, createdAt])
  @@index([sourceColumnId])
  @@index([sdgFocus], type: Gin)
  @@map("short_stories")
}

// One variant = one (locale × age tier) combination of a ShortStory.
// Each variant carries its own caption, hashtags, storyboard, and approval
// cycle. Sensitive age-tier (children) variants run an extra safety check.
model StoryVariant {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  shortStoryId    String   @map("short_story_id") @db.Uuid
  locale          String   // e.g. 'ko', 'sw', 'ar'
  ageTier         String   @map("age_tier") // 'children' | 'teen' | 'adult' | 'senior'
  // Plain-text caption / hook / cta in the target locale.
  caption         String
  hooks           String[] @default([])
  ctaText         String?  @map("cta_text")
  hashtags        String[] @default([])
  // Full storyboard JSON — see ADR-0015 §3 for structure.
  storyboard      Json
  // 'ai-assisted' or 'curator-only' or 'community' — for the watermark.
  attribution     String   @default("ai-assisted")
  // Per-variant editorial state. Variants of one story can be approved/posted
  // independently so that, e.g., the Swahili senior variant can ship before
  // the Korean children variant.
  state           String   @default("draft") // draft | pending | approved | rejected | retired
  // Safety check outcome: { ok: bool, results: [{rule, ok, message}] }
  safetyReport    Json?    @map("safety_report")
  approvedAt      DateTime? @map("approved_at")
  createdAt       DateTime @default(now()) @map("created_at")

  shortStory ShortStory          @relation(fields: [shortStoryId], references: [id])
  posts      DistributionPost[]

  @@unique([shortStoryId, locale, ageTier])
  @@index([tenantId, state, createdAt])
  @@map("story_variants")
}

// A registered destination (platform × tenant account). The OAuth/API
// credentials live on the tenant side, not in our DB; we store only the
// reference id and posting policy. See ADR-0015 §4.
model DistributionTarget {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  platform        String   // 'youtube_shorts' | 'instagram_reels' | 'tiktok' | 'x_video'
                           // 'facebook_reels' | 'linkedin_video' | 'kakao_clip' | 'weibo_video'
  accountHandle   String   @map("account_handle") // public handle, e.g. '@sdgi_global'
  // Reference to a partner-side credential (e.g. token id stored in their KMS).
  // We never store raw OAuth tokens. See ADR-0015 §4 ('partner holds tokens').
  credentialRef   String?  @map("credential_ref")
  active          Boolean  @default(true)
  // Per-target posting policy: timezone, allowed age tiers, allowed SDGs, etc.
  policy          Json?
  createdAt       DateTime @default(now()) @map("created_at")

  posts DistributionPost[]

  @@unique([tenantId, platform, accountHandle])
  @@index([tenantId, active])
  @@map("distribution_targets")
}

// One scheduled post = one StoryVariant × one DistributionTarget. The unique
// constraint guarantees we never double-post the same variant to the same
// target. State machine: ready → queued → posted / failed; posted → retracted.
model DistributionPost {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  variantId       String   @map("variant_id") @db.Uuid
  targetId        String   @map("target_id") @db.Uuid
  state           String   @default("ready") // ready | queued | posted | failed | retracted
  scheduledFor    DateTime? @map("scheduled_for")
  postedAt        DateTime? @map("posted_at")
  retractedAt     DateTime? @map("retracted_at")
  externalPostId  String?   @map("external_post_id") // platform-side id once posted
  externalUrl     String?   @map("external_url")
  // Last metric snapshot from the platform (impressions, likes, shares, comments, ts).
  metrics         Json?
  metricsUpdatedAt DateTime? @map("metrics_updated_at")
  // Failure information so curators can fix and retry.
  lastError       String?   @map("last_error")
  createdAt       DateTime @default(now()) @map("created_at")

  variant StoryVariant       @relation(fields: [variantId], references: [id])
  target  DistributionTarget @relation(fields: [targetId], references: [id])

  @@unique([variantId, targetId])
  @@index([tenantId, state, scheduledFor])
  @@map("distribution_posts")
}
