# Copy to .env and fill in real values. NEVER commit .env files.

# --- Web (apps/web) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# --- API (apps/api) ---
PORT=4000
DATABASE_URL=postgresql://sdgi:sdgi_dev@localhost:5432/sdgi
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace_me_with_long_random_string
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=sdgi
S3_SECRET_KEY=sdgi_dev_secret
S3_BUCKET=sdgi-dev

# --- AI Gateway (apps/ai) ---
SDGI_AI_ANTHROPIC_API_KEY=
SDGI_AI_ANTHROPIC_MODEL_DEFAULT=claude-sonnet-4-6
SDGI_AI_ANTHROPIC_MODEL_REPORT=claude-opus-4-7
SDGI_AI_ANTHROPIC_MODEL_SUMMARY=claude-haiku-4-5-20251001
SDGI_AI_LOG_LEVEL=INFO

# --- Worker (apps/worker) ---
# uses REDIS_URL above
